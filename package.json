{
  "name": "tcg-pack-simulator",
  "version": "1.7.1",
  "description": "A Trading Card Game Pack Opening Simulator built with Electron",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "clean": "rimraf dist",
    "test:smoke": "electron test/smoke.js",
    "test:scale": "electron test/scale.js",
    "test:prune": "electron test/prune.js",
    "test:chart": "electron test/chart.js",
    "test:sell": "electron test/sell.js",
    "test:packs": "electron test/packs.js",
    "test:registry": "electron test/registry.js",
    "test:customstore": "electron test/customstore.js",
    "test:customsets": "electron test/customsets.js",
    "test:custommerge": "electron test/custommerge.js",
    "build:css": "tailwindcss -c tailwind.config.js -i src/vendor/tailwind.src.css -o src/vendor/tailwind.css --minify",
    "force-clean": "rimraf dist && timeout 2",
    "prebuild": "npm run clean && npm run build:css",
    "build": "electron-builder",
    "build-win": "npm run force-clean && electron-builder --win",
    "build-mac": "npm run force-clean && electron-builder --mac",
    "build-linux": "npm run force-clean && electron-builder --linux",
    "build-safe": "npm run clean && timeout 3 && electron-builder",
    "dist": "npm run build"
  },
  "keywords": [
    "tcg",
    "trading cards",
    "pack simulator",
    "electron",
    "game"
  ],
  "author": "shorres",
  "license": "MIT",
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "chart.js": "^4.5.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "date-fns": "^4.4.0",
    "electron": "^38.3.0",
    "electron-builder": "^24.9.1",
    "rimraf": "^5.0.0",
    "tailwindcss": "^3.4.19"
  },
  "build": {
    "appId": "com.cardpacksim.tcgpacksimulator",
    "productName": "TCG_Pack_Simulator",
    "publish": null,
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "src/**/*",
      "!src/vendor/tailwind.src.css",
      "assets/icon*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable"
        }
      ],
      "artifactName": "${productName}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "artifactName": "${productName}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
